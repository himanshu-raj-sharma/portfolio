# Copy to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real secrets.

# --- Public (exposed to the browser via NEXT_PUBLIC_*) ----------------------

# Canonical site origin. Used for metadataBase, OG image URLs, sitemap and
# canonical links. MUST be set in production (Vercel) or social previews and
# sitemap entries will point at http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site name used in metadata/JSON-LD.
NEXT_PUBLIC_SITE_NAME=Himanshu Raj Sharma

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=

# --- Server (never exposed to the browser) -----------------------------------

# Resend API key for the contact form.
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=

# Verified Resend "from" address on your domain.
CONTACT_FROM_EMAIL=

# Optional: Upstash Redis for contact form rate limiting.
# Without these the form still works but is unthrottled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
