# Copy to `.env.local` for local development, or paste into Vercel under
# Settings → Environment Variables. `.env.local` is gitignored — never commit
# real secrets.

# --- Public (exposed to the browser via NEXT_PUBLIC_*) ----------------------

# Canonical site origin. Used for metadataBase, OG image URLs, sitemap and
# canonical links.
#
# On Vercel this is optional: when it is not set, the build falls back to
# VERCEL_PROJECT_PRODUCTION_URL (your .vercel.app domain) and then to the
# deployment URL, so a first deploy never publishes localhost URLs.
# Set it explicitly once you add a custom domain, e.g.
#   NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server (never exposed to the browser) -----------------------------------

# Resend API key for the contact form — https://resend.com/api-keys
# Without it the form still validates and accepts, but nothing is emailed.
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=

# Verified Resend "from" address on your domain.
CONTACT_FROM_EMAIL=

# Upstash Redis for contact form rate limiting — https://console.upstash.com
# Optional, but recommended on Vercel: the in-memory fallback is per serverless
# instance, so it does not throttle a real attacker across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
