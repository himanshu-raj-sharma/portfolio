# --- Required for production contact form ---
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# The inbox that should receive inquiries (you)
CONTACT_TO_EMAIL=
# A verified sender address on the Resend domain (no-reply@yourdomain.com)
CONTACT_FROM_EMAIL=

# --- Optional: Upstash Redis for distributed rate limiting ---
# Local dev / single-instance deployments use an in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Public ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Himanshu Raj Sharma"
